{
  "name": "halftone-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=11.11.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy -c dist/halftone_web/wrangler.json",
    "test": "vitest run --project unit",
    "test:worker": "vitest run --project worker",
    "test:e2e": "playwright test",
    "lint": "eslint src worker db --ignore-pattern dist",
    "db:generate": "drizzle-kit generate",
    "auth:schema": "npx @better-auth/cli@latest generate --config ./worker/auth.cli-config.ts --output ./db/auth.schema.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.4",
    "@sentry/react": "^10.74.0",
    "@xmldom/xmldom": "0.9.12",
    "@zip.js/zip.js": "^2.14.0",
    "better-auth": "1.7.4",
    "better-auth-cloudflare": "0.3.1",
    "drizzle-orm": "0.45.2",
    "hono": "4.13.7",
    "idb": "^8.0.3",
    "lucide-react": "1.27.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-router": "7.18.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@cloudflare/vitest-plugin": "1.1.8",
    "@cloudflare/workers-types": "5.20260911.1",
    "@eslint/js": "9.39.4",
    "@playwright/test": "1.62.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@tailwindcss/vite": "4.2.2",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "5.2.0",
    "jszip": "3.10.1",
    "tailwindcss": "4.2.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.131.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.2"
    }
  }
}
